# ── IA (Claude) ── https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# Opcional: modelo de la IA (por defecto claude-haiku-5-5, el más económico)
# CLAUDE_MODEL=claude-opus-5-5

# ── Cuentas de usuario (Supabase) ── Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cobros (Mercado Pago) ── Tus integraciones → Credenciales de producción
MP_ACCESS_TOKEN=
# Webhooks → "Clave secreta" (para verificar las notificaciones)
MP_WEBHOOK_SECRET=

# ── Plan ──
PLAN_NAME=Impulsa Studio — Plan mensual
PLAN_PRICE=25000
PLAN_CURRENCY=ARS
AI_MONTHLY_LIMIT=200
# Prueba gratis desde el registro (0 = sin prueba) y créditos de IA durante la prueba
TRIAL_DAYS=3
TRIAL_AI_LIMIT=20

# Mails con acceso al panel /admin (separados por coma)
ADMIN_EMAILS=
# Dirección pública de la web, ej. https://impulsa-studiodigital.vercel.app
NEXT_PUBLIC_SITE_URL=
